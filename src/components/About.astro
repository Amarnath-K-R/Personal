---
import { beliefs, filmFacts, filmHope } from '../data/site';
import DisplayText from './DisplayText.astro';
---
<div class="about-section opening-biography" id="about" aria-labelledby="about-title">
  <div class="about-topline content-width">
    <p class="eyebrow"><span class="eyebrow-index">01</span> My mission</p>
    <span class="about-label">Why I build</span>
  </div>

  <!-- "The Distance": one pinned screen. The light-form and every line of text live on it; the words
       fade or type in place (they never scroll). The empty beats below only set how long each part lasts.
       Without WebGL, motion or a wide screen, the text simply stacks and the poster stands in. -->
  <div class="film" data-film>
    <!-- Fixed to the screen (not the pinned stage) so the light can follow the reader down into Contact. -->
    <canvas class="film-canvas" aria-hidden="true"></canvas>
    <div class="film-stage">
      <img class="film-poster" src="/film/poster.webp" alt="" aria-hidden="true" width="1440" height="900" loading="lazy" decoding="async" />
      <div class="film-backdrop" data-backdrop="voice" aria-hidden="true"><img src="/manus-storage/async-images/fTxHw7aSTriR5Zmpy8XDiQ/image-1.webp" alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
      <div class="film-backdrop" data-backdrop="reach" aria-hidden="true"><img src="/manus-storage/async-images/fTxHw7aSTriR5Zmpy8XDiQ/image-2.webp" alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
      <div class="film-shade" aria-hidden="true"></div>

      <div class="film-text content-width">
        <p class="film-block film-whisper" data-show="0.34,0.8" data-type>Somewhere tonight, someone is a long way from a <em>doctor.</em></p>

        <p class="film-block film-label about-chapter-label" data-show="1.02,2.02"><span>00</span> / THE DISTANCE</p>
        {filmFacts.map((fact, i) => <div class="film-block film-figure" data-show={['1.04,1.34', '1.38,1.66', '1.7,2.0'][i]}>
          <p class="film-figure-value">{fact.value}</p>
          <p class="film-figure-line">{fact.line}</p>
          <a class="film-source" href={fact.url} target="_blank" rel="noopener">{fact.source}</a>
        </div>)}

        <div class="film-block film-hope" data-show="2.05,2.42">
          <p class="film-hope-line">{filmHope.line}</p>
          <p class="film-hope-close" data-type>{filmHope.close}</p>
          <a class="film-source" href={filmHope.url} target="_blank" rel="noopener">{filmHope.source}</a>
        </div>

        <div class="film-block about-introduction" data-show="2.47,2.98">
          <div class="about-title-wrap">
            <p class="about-kicker">Technology for the people far from care</p>
            <h2 class="about-title" id="about-title" aria-label="Technology in service of people.">
              <span class="about-title-line"><span data-editorial-line><DisplayText text="Technology" /></span></span>
              <span class="about-title-line"><span data-editorial-line><DisplayText text="in service of" /></span></span>
              <span class="about-title-line about-title-last"><span data-editorial-line><em>people.</em></span></span>
            </h2>
          </div>
          <div class="about-intro-copy">
            <p class="about-lede">Too many people live beyond the reach of a specialist. I believe AI, built with care, can bring early, quality care closer to them, wherever they are.</p>
            <p class="about-current">Technology is worth building only if it helps real people. It should support doctors and never replace them, be honest about its limits, and protect patient privacy.</p>
            <p class="about-current about-aim">I work across biomedical AI, retinal imaging, multiomics and clinical AI. My aim is to keep learning, keep building, and use what I learn to serve the world.</p>
          </div>
        </div>

        <div class="film-block film-copy film-right" data-show="3.06,3.96">
          <p class="about-chapter-label"><span>01</span> / VOICE</p>
          <h3 data-type>Research is a <em>conversation.</em></h3>
          <p class="film-body">I’m a speaker who has shared my work at multiple conferences. I value the chance to make complex ideas clear, hear how others see the problem, and bring those conversations back to the questions that matter in healthcare.</p>
          <p class="film-caption">Backdrop: AI-generated illustration of an imagined conference</p>
        </div>

        <div class="film-block film-copy" data-show="4.05,4.9">
          <p class="about-chapter-label"><span>02</span> / PRACTICE</p>
          <h3 data-type>Tools belong <em>close to care.</em></h3>
          <p class="film-body">My interests move between retinal imaging, single-cell and multiomics, and local clinical AI. Different signals, one shared aim: make evidence more useful to the people making decisions, without asking technology to replace clinical judgment.</p>
          <p class="film-signals" aria-hidden="true"><span>Genome</span><span>Signal</span><span>Image</span></p>        </div>

        <div class="film-block film-copy film-right" data-show="5.0,5.96">
          <p class="about-chapter-label"><span>03</span> / DIRECTION</p>
          <h3 data-type>Care should <em>reach further.</em></h3>
          <p class="film-body">I want to work alongside healthcare teams and help provide high-quality medical care to rural populations. The technology matters only if it can serve people well—close to where care happens, and shaped around the realities of the communities it is meant to reach.</p>
          <p class="film-caption">Backdrop: AI-generated illustration of an imagined rural-care consultation</p>
        </div>

        <div class="film-block about-principles" data-show="6.06,7.02">
          <div class="about-principles-heading">
            <p class="about-chapter-label">THE PRINCIPLES I RETURN TO</p>
            <h2 data-type>Keep the human <em>in the loop.</em></h2>
          </div>
          <ol class="about-principle-list">
            {beliefs.map((belief, index) => <li class="about-principle-row film-step" data-show={`${(6.16 + index * .14).toFixed(2)},7.02`}>
              <span class="about-principle-number">0{index + 1}</span>
              <div>
                <h3>{belief.title}</h3>
                <p>{belief.sentence}</p>
              </div>
            </li>)}
          </ol>
        </div>
      </div>
    </div>

    <div class="film-beats" aria-hidden="true">
      {[0, 1, 2, 3, 4, 5, 6, 7].map((beat) => <div class="film-beat" data-beat={beat}></div>)}
    </div>
  </div>
</div>
