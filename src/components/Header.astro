---
import { profileLinks } from '../data/site';
const root = Astro.url.pathname === '/' ? '' : '/';
---
<header class="site-header" id="site-header">
  <a class="brand-lockup" href={`${root}#top`} aria-label="Amarnath K R, home">
    <span class="brand-monogram" aria-hidden="true">A<span>K</span>R</span>
    <span class="brand-name">Amarnath K R<small>Biomedical AI</small></span>
  </a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href={`${root}#about`}>About</a>
    <a href={`${root}#work`}>Projects</a>
    <a href={`${root}#publications`}>Research</a>
    <a href={`${root}#moments`}>Notes</a>
    <a href={`${root}#contact`}>Contact</a>
  </nav>
  <div class="header-end">
    <nav class="header-profile-links" aria-label="Professional profiles">
      <a href={profileLinks.stanford} target="_blank" rel="noopener noreferrer" aria-label="Amarnath K R's Stanford biography, opens in a new tab">Stanford bio <span aria-hidden="true">↗</span></a>
      <a href={profileLinks.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Amarnath K R on LinkedIn, opens in a new tab">LinkedIn <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <div class="reading-progress" aria-hidden="true"><span id="reading-progress-fill"></span></div>
</header>
