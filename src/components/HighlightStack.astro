---
// One highlight on the wall: a small pile of glass slabs with the main photo on top.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'highlights'>; instance: number; }
const { post, instance } = Astro.props;
const d = post.data;
const area = { cyan: 'imaging', violet: 'omics', pink: 'trust', amber: 'clinical' }[d.color];

// Seeded, so the slabs behind each highlight fan out a little differently but never change between builds.
let seed = 2166136261;
for (const ch of `${post.id}:${instance}`) seed = Math.imul(seed ^ ch.charCodeAt(0), 16777619);
const rand = () => { seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
const between = (a: number, b: number) => +(a + rand() * (b - a)).toFixed(2);
const style = [
  `--r1:${between(-5, -2)}deg`, `--x1:${between(-5, -2)}%`, `--y1:${between(-2, 2)}%`,
  `--r2:${between(2, 5)}deg`, `--x2:${between(2, 5)}%`, `--y2:${between(-2, 2)}%`,
].join(';');
const ratio = d.cover ? `${d.cover.width} / ${d.cover.height}` : '4 / 3';
const aspect = d.cover ? d.cover.width / d.cover.height : 4 / 3;
const backs = [d.photos[0], d.photos[1]];
const sizes = '(min-width: 701px) 38vw, 46vw';
---
<a
  class="stack"
  href={`/highlights/${post.id}/`}
  data-stack
  data-slug={post.id}
  data-ar={aspect.toFixed(4)}
  data-featured={d.featured ? 'true' : undefined}
  style={`${style};--ratio:${ratio}`}
  draggable="false"
  aria-label={`${d.title}. ${d.place}, ${d.venue}. Open the story`}
>
  <span class="stack-pile" aria-hidden="true">
    {backs.map((photo, i) => <span class={`print print-back print-back-${i + 1}`}>
      {photo ? <span class="print-photo"><Image src={photo.src} alt={photo.alt} widths={[400]} sizes={sizes} draggable="false" /></span> : <span class="print-photo print-blank"></span>}
    </span>)}
    <span class="print print-top">
      <span class="print-photo">
        {d.cover
          ? <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[480, 800, 1080]} sizes={sizes} draggable="false" />
          : <canvas class="print-art" data-cover data-seed={`moment-${post.id}`} data-area={area} width="900" height="675"></canvas>}
        {!d.cover && <span class="print-note">Original generated artwork · not a photograph</span>}
      </span>
      <span class="print-caption">
        <strong class="print-title">{d.title}</strong>
        <span class="print-date">{d.date || d.place}</span>
      </span>
    </span>
  </span>
</a>
