---
import { products } from '../data/site';
import DisplayText from './DisplayText.astro';
import SceneNext from './SceneNext.astro';
// Tells search engines Amar made each product; the Person node with this @id is in Base.astro.
const productData = products.map((product) => ({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: product.name,
  url: product.url,
  description: product.summary,
  creator: { '@id': new URL('/#person', Astro.site).href },
}));
---
<script type="application/ld+json" set:html={JSON.stringify(productData)} />
<section class="publication-section product-section content-width" id="products" data-sec="Products" aria-labelledby="products-title">
  <div class="publication-heading" data-reveal>
    <div><p class="eyebrow"><span class="eyebrow-index">04</span> What I build</p><h2 id="products-title" aria-label="Products I have built."><DisplayText text="Products" /><br /><em>I have built.</em></h2></div>
    <p class="publication-intro">Software I designed and built, live for anyone to use.</p>
  </div>
  {products.map((product) => (
    <article class="product-card" data-reveal aria-labelledby={`product-${product.name}`}>
      <div class="product-lead">
        <p class="product-name"><span id={`product-${product.name}`}>{product.name}</span><small>{product.status}</small></p>
        <p class="product-tagline">{product.tagline}</p>
        <p class="product-note">{product.note}</p>
        <p class="product-summary">{product.summary}</p>
        <ul class="product-facts">{product.facts.map((fact) => <li>{fact}</li>)}</ul>
        <a class="button button-dark" href={product.url} target="_blank" rel="noopener">Visit {new URL(product.url).host} <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="product-tools">
        {product.tools.map((tool, index) => (
          <li><span class="pub-number">{String(index + 1).padStart(2, '0')}</span><span class="pub-main"><strong>{tool.name}</strong><small>{tool.line}</small></span></li>
        ))}
      </ol>
    </article>
  ))}
  <SceneNext href="#moments" kicker="NEXT / 05" label="Highlights" />
</section>

<style>
  .product-card { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 80px); margin-top: 70px; padding: clamp(24px, 4vw, 52px); border: 1px solid var(--line); border-radius: 26px; background: linear-gradient(130deg, rgb(215 231 255 / .055), rgb(212 230 255 / .008)); backdrop-filter: blur(10px); }
  .product-lead { display: grid; align-content: start; justify-items: start; gap: 14px; }
  .product-name { display: flex; align-items: center; gap: 12px; margin: 0; color: #edf2ff; font: 700 clamp(34px, 4vw, 54px)/1 var(--sans); letter-spacing: -.04em; }
  .product-name small { padding: 4px 9px; border: 1px solid var(--line); border-radius: 99px; color: var(--accent); font: 500 10px var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .product-tagline { margin: 6px 0 0; color: var(--accent); font: 400 clamp(22px, 2.2vw, 30px)/1.2 var(--serif); }
  .product-note { margin: 0; color: #8599b8; font: 500 10px var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .product-summary { max-width: 42ch; margin: 8px 0 0; color: #a9b8d2; font: 400 18px/1.5 var(--serif); }
  .product-facts { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0 0 12px; padding: 0; color: #a0b1cd; font: 500 10px var(--mono); letter-spacing: .06em; list-style: none; text-transform: uppercase; }
  .product-facts li::before { content: '· '; color: var(--accent); }
  .product-tools { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .product-tools li { display: grid; grid-template-columns: 42px 1fr; gap: 20px; padding-block: 20px; border-bottom: 1px solid var(--line); }
  @media (max-width: 700px) {
    .product-card { grid-template-columns: 1fr; margin-top: 42px; border-radius: 20px; }
    .product-summary { font-size: 16px; }
    .product-tools li { grid-template-columns: 26px 1fr; gap: 11px; padding-block: 16px; }
  }
</style>
