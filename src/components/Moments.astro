---
import { getCollection } from 'astro:content';
import DisplayText from './DisplayText.astro';
import SceneNext from './SceneNext.astro';
import HighlightStack from './HighlightStack.astro';

const posts = (await getCollection('highlights')).sort((a, b) => a.data.order - b.data.order);
// The wall's order: reading order, except two highlights from the same place never sit side by side.
const queue = [...posts];
const sequence: typeof posts = [];
while (queue.length) {
  const next = queue.findIndex((post) => post.data.place !== sequence.at(-1)?.data.place);
  sequence.push(...queue.splice(Math.max(next, 0), 1));
}
// One slab per highlight: highlights.ts wraps them round as the rail drifts.
---
<section class="moments-section" id="moments" data-sec="Highlights" aria-labelledby="moments-title">
  <div class="wall-stage" data-wall-stage>
    <header class="wall-masthead" data-reveal>
      <p class="eyebrow"><span class="eyebrow-index">05</span> Along the way</p>
      <h2 id="moments-title" aria-label="Where the work has taken me."><DisplayText text="Where the work" /><br /><em>has taken me.</em></h2>
    </header>
    <nav class="wall-rail" aria-label="Leave highlights">
      <a href="#work">Projects</a>
      <a href="#publications">Publications</a>
      <a href="#products">Products</a>
      <a href="#contact">Contact</a>
      <a class="wall-rail-back" href="#top"><span aria-hidden="true">↑</span> Back to About</a>
    </nav>
    <div class="wall" data-wall>
      {sequence.map((post, i) => <HighlightStack post={post} instance={i} />)}
    </div>
  </div>
  <SceneNext href="#top" kicker="BACK TO / 01" label="About & me" final />
</section>
