---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Chapter from '../components/Chapter.astro';
import Publications from '../components/Publications.astro';
import Products from '../components/Products.astro';
import Moments from '../components/Moments.astro';
import HighlightPost from '../components/HighlightPost.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const nextFor = (index: number) => ({ project: projects[(index + 1) % projects.length], index: (index + 1) % projects.length });
const highlights = (await getCollection('highlights')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <main id="main">
    <Hero />
    <Work projects={projects} />
    <Publications />
    <Products />
    <Moments />
  </main>
  <div slot="overlay" class="project-overlay" id="project-overlay" hidden inert role="dialog" aria-modal="true" aria-label="Project case study">
    <div class="overlay-scroll" data-lenis-prevent>
      {projects.map((project, index) => <Chapter project={project} index={index} next={nextFor(index)} />)}
    </div>
  </div>
  <dialog slot="overlay" class="highlight-dialog" id="highlight-dialog" aria-label="Highlight" data-lenis-prevent>
    <button type="button" class="hl-close" data-hl-close aria-label="Close this highlight">✕</button>
    {highlights.map((post) => <HighlightPost post={post} />)}
  </dialog>
</Base>
