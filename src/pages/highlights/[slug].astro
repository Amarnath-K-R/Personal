---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HighlightPost from '../../components/HighlightPost.astro';
export async function getStaticPaths() {
  const posts = (await getCollection('highlights')).sort((a, b) => a.data.order - b.data.order);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const image = post.data.cover ? (await getImage({ src: post.data.cover, width: 1200, format: 'jpeg' })).src : undefined;
---
<Base title={`${post.data.title} · Amarnath K R`} description={post.data.summary} image={image} noindex>
  <main id="main" class="highlight-page">
    <a class="hl-back" href="/#moments"><span aria-hidden="true">←</span> All highlights</a>
    <HighlightPost post={post} standalone />
  </main>
</Base>
