---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Amarnath K R" description="The requested page is not available.">
  <main id="main" class="not-found content-width">
    <p class="eyebrow"><span class="eyebrow-index">404</span> Not found</p>
    <h1>This page<br />is out of <em>frame.</em></h1>
    <p>The link may have moved or been typed incorrectly. The work is still easy to find.</p>
    <a class="button button-dark" href="/">Return to the portfolio <span aria-hidden="true">↗</span></a>
  </main>
</Base>
